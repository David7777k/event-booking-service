# Copy to .env and adjust. .env is git-ignored and must never be committed.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatflow
DB_USER=seatflow
DB_PASSWORD=change-me

SERVER_PORT=8080

# Signing key for access tokens. At least 32 characters: HS256 keys shorter
# than 256 bits weaken the signature. Generate one, never reuse this line:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT30M

# BCrypt cost. Each step doubles the work; 12 is a few hundred milliseconds
# per login. Lower it only for test runs.
BCRYPT_STRENGTH=12
